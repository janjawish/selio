<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/selio-logo.ico</ApplicationIcon>
    <AssemblyName>Selio</AssemblyName>
    <RootNamespace>Selio</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Version>1.0.0</Version>
    <Product>Sélio</Product>
    <Description>Le texte, partout.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Selio.Core/Selio.Core.csproj" />
    <EmbeddedResource Include="../../assets/selio-logo.png" LogicalName="Selio.Logo.png" />
    <EmbeddedResource Include="../../assets/selio-logo.ico" LogicalName="Selio.Logo.ico" />
  </ItemGroup>
</Project>
